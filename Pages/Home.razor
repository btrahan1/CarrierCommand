@page "/"
@inject IJSRuntime JSRuntime

<PageTitle>Carrier Command</PageTitle>

<div class="game-container">
    <canvas id="renderCanvas"></canvas>
    
    <div class="ui-overlay">
        <div class="header-section">
            <h1 class="game-title">Carrier Command</h1>
            <p class="game-subtitle">Captain on the Bridge</p>
        </div>
        <div class="carrier-status">
            <div class="status-label">CARRIER HULL INTEGRITY</div>
            <div class="hp-gauge large">
                <div class="hp-fill @(carrierHp < 10 ? "critical" : "")" 
                     style="width: @( (carrierHp / carrierMaxHp) * 100 )%"></div>
            </div>
            <div class="hp-values">@carrierHp / @carrierMaxHp HP</div>
        </div>

        <div class="mission-status-hud">
            PHASE: <span class="phase-value">@currentPhase.ToUpper()</span>
        </div>

        @if (currentPhase == "Naval" && unitStates.Count > 0 && activeThreatCount == 0 && !isWarping)
        {
            <button class="btn-assault" @onclick="AssaultBase">ASSAULT BASE</button>
        }
        else if (currentPhase == "Assault" && activeThreatCount == 0)
        {
            <button class="btn-missile" @onclick="LaunchMissile">LAUNCH CRUISE MISSILE</button>
        }
        else if (currentPhase == "Missile" || currentPhase == "Cleared")
        {
            <button class="btn-success" @onclick="SetCleared">MISSION SUCCESS</button>
        }
        <div class="tactical-controls">
            <LaunchMenu UnitStates="unitStates" />
            
            <div class="defense-controls">
                <button class="btn-engage @(isGunsEngaged ? "engaged" : "")" @onclick="ToggleGuns">
                    @(isGunsEngaged ? "Guns Engaged" : "Engage Guns")
                </button>
                <button class="btn-sector-map" @onclick="ToggleSectorMap">STRATEGIC MAP</button>
            </div>
        </div>

        <RadarDisplay 
            RadarSweepAngle="radarSweepAngle" 
            CarrierHeading="carrierHeading" 
            RadarBlips="radarBlips" />

        @if (currentPhase == "Assault")
        {
            <CombatStatus Enemies="radarBlips" />
        }
    </div>

    @if (showSectorMap)
    {
        <SectorMap Status="sectorStatus" OnClose="ToggleSectorMap" OnWarp="HandleWarp" />
    }

    @if (showNeutralizedAlert)
    {
        <div class="neutralized-alert" @onclick="() => showNeutralizedAlert = false">
            <div class="alert-content">
                <h1>SECTOR NEUTRALIZED</h1>
                <p>ALL HOSTILES ELIMINATED. REGION SECURED.</p>
                <button class="btn-dismiss">PROCEED</button>
            </div>
        </div>
    }

    @if (warpTimeRemaining > 0)
    {
        <div class="sailing-overlay">
            <div class="sailing-content">
                <h2>SAILING TO @targetSectorName.ToUpper()...</h2>
                <div class="progress-container">
                    <div class="progress-bar" style="width: @( (10 - warpTimeRemaining) * 10 )%"></div>
                </div>
                <p class="eta">ETA: @(Math.Ceiling(warpTimeRemaining)) SECONDS</p>
            </div>
        </div>
    }
</div>

<style>
    .game-container {
        position: fixed;
        top: 0;
        left: 0;
        width: 100vw;
        height: 100vh;
        overflow: hidden;
        background: #000;
    }

    #renderCanvas {
        width: 100%;
        height: 100%;
        outline: none;
    }

    .carrier-status {
        position: absolute;
        top: 20px;
        right: 20px;
        width: 300px;
        background: rgba(0, 20, 40, 0.6);
        padding: 15px;
        border-radius: 8px;
        border-right: 4px solid #00aaff;
        backdrop-filter: blur(5px);
        pointer-events: none;
    }

    .status-label {
        font-size: 0.7rem;
        color: #00aaff;
        letter-spacing: 2px;
        margin-bottom: 8px;
    }

    .hp-gauge.large {
        height: 8px;
        background: rgba(255,255,255,0.1);
        border-radius: 4px;
        margin-bottom: 5px;
    }

    .hp-values {
        font-size: 0.8rem;
        text-align: right;
        color: white;
        opacity: 0.8;
    }

    .mission-status-hud {
        position: absolute;
        top: 100px;
        right: 20px;
        color: #00ff88;
        font-size: 0.8rem;
        letter-spacing: 2px;
        background: rgba(0, 0, 0, 0.4);
        padding: 5px 10px;
        border-radius: 4px;
    }

    .phase-value {
        font-weight: bold;
        text-shadow: 0 0 5px #00ff88;
    }

    .btn-assault, .btn-missile, .btn-success {
        position: absolute;
        bottom: 250px;
        left: 50%;
        transform: translateX(-50%);
        padding: 15px 40px;
        font-size: 1.2rem;
        background: #ff9900;
        color: black;
        border: none;
        border-radius: 4px;
        cursor: pointer;
        font-weight: bold;
        letter-spacing: 2px;
        box-shadow: 0 0 20px rgba(255, 153, 0, 0.5);
        animation: pulse-button 2s infinite;
        z-index: 5000;
        pointer-events: auto;
    }

    .btn-missile {
        background: #ff4400;
        box-shadow: 0 0 20px rgba(255, 68, 0, 0.5);
    }

    .btn-success {
        background: #00ff88;
        box-shadow: 0 0 20px rgba(0, 255, 136, 0.5);
    }

    @@keyframes pulse-button {
        0% { transform: translateX(-50%) scale(1.0); }
        50% { transform: translateX(-50%) scale(1.05); }
        100% { transform: translateX(-50%) scale(1.0); }
    }

    .ui-overlay {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        padding: 40px;
        color: white;
        text-shadow: 2px 2px 8px rgba(0,0,0,0.8);
        pointer-events: none;
        box-sizing: border-box;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
    }

    .header-section {
        margin-bottom: 20px;
    }

    .game-title {
        font-size: 4rem;
        margin: 0;
        font-weight: 800;
        letter-spacing: -2px;
        text-transform: uppercase;
        background: linear-gradient(180deg, #fff 0%, #aaa 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }

    .game-subtitle {
        font-size: 1.2rem;
        margin: 0;
        opacity: 0.8;
        font-style: italic;
    }

    .tactical-controls {
        display: flex;
        flex-direction: column;
        gap: 20px;
        width: fit-content;
    }

    .defense-controls {
        pointer-events: auto;
    }

    .btn-engage {
        background: rgba(255, 50, 50, 0.2);
        border: 2px solid #ff4444;
        color: #ff4444;
        padding: 15px 30px;
        font-size: 1.2rem;
        font-weight: bold;
        text-transform: uppercase;
        cursor: pointer;
        transition: all 0.3s;
        border-radius: 4px;
        width: 100%;
        backdrop-filter: blur(5px);
    }

    .btn-engage:hover {
        background: rgba(255, 50, 50, 0.4);
        box-shadow: 0 0 15px rgba(255, 68, 68, 0.5);
    }

    .btn-engage.engaged {
        background: #ff4444;
        color: white;
        animation: pulse-red 1.5s infinite;
    }

    .btn-sector-map {
        background: rgba(0, 150, 255, 0.2);
        border: 2px solid #00aaff;
        color: #00aaff;
        padding: 10px 30px;
        margin-top: 10px;
        font-size: 1rem;
        font-weight: bold;
        text-transform: uppercase;
        cursor: pointer;
        transition: all 0.3s;
        border-radius: 4px;
        width: 100%;
        backdrop-filter: blur(5px);
    }

    .btn-sector-map:hover {
        background: rgba(0, 150, 255, 0.4);
        box-shadow: 0 0 15px rgba(0, 170, 255, 0.5);
    }

    .neutralized-alert {
        position: fixed;
        top: 0;
        left: 0;
        width: 100vw;
        height: 100vh;
        background: rgba(0, 40, 0, 0.8);
        display: flex;
        justify-content: center;
        align-items: center;
        z-index: 3000;
        pointer-events: auto;
        animation: fade-in 0.5s;
    }

    .alert-content {
        text-align: center;
        border: 4px solid #0f0;
        padding: 60px;
        background: #000;
        box-shadow: 0 0 50px #0f0;
    }

    .alert-content h1 {
        font-size: 5rem;
        color: #0f0;
        margin: 0;
        animation: blink 0.5s infinite alternate;
    }

    .btn-dismiss {
        background: #0f0;
        color: #000;
        padding: 15px 40px;
        font-weight: bold;
        border: none;
        margin-top: 30px;
        cursor: pointer;
    }

    .sailing-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100vw;
        height: 100vh;
        background: radial-gradient(circle, transparent 20%, rgba(0, 20, 40, 0.6) 100%),
                    repeating-linear-gradient(0deg, rgba(0, 255, 255, 0.03) 0px, transparent 1px, transparent 4px);
        display: flex;
        justify-content: center;
        align-items: center;
        z-index: 4000;
        color: #00aaff;
        font-family: 'Courier New', Courier, monospace;
        backdrop-filter: blur(2px);
        animation: sailing-pulse 4s infinite alternate;
    }

    @@keyframes sailing-pulse {
        from { background-color: rgba(0, 10, 30, 0.2); }
        to { background-color: rgba(0, 30, 60, 0.4); }
    }

    .sailing-content {
        text-align: center;
        width: 600px;
    }

    .progress-container {
        width: 100%;
        height: 4px;
        background: rgba(0, 170, 255, 0.2);
        margin: 20px 0;
        border-radius: 2px;
        overflow: hidden;
    }

    .progress-bar {
        height: 100%;
        background: #00aaff;
        box-shadow: 0 0 15px #00aaff;
        transition: width 0.1s linear;
    }

    .eta {
        font-size: 1.2rem;
        letter-spacing: 2px;
        opacity: 0.8;
    }

    @@keyframes blink {
        from { opacity: 1; }
        to { opacity: 0.5; }
    }

    @@keyframes fade-in {
        from { opacity: 0; }
        to { opacity: 1; }
    }

    @@keyframes pulse-red {
        0% { box-shadow: 0 0 0 0 rgba(255, 68, 68, 0.7); }
        70% { box-shadow: 0 0 0 15px rgba(255, 68, 68, 0); }
        100% { box-shadow: 0 0 0 0 rgba(255, 68, 68, 0); }
    }
</style>

@code {
    private double radarSweepAngle = 0;
    private double carrierHeading = 0;
    private List<RadarBlip> radarBlips = new();
    private List<UnitStatus> unitStates = new();
    private bool isGunsEngaged = false;
    private bool showSectorMap = false;
    private bool showNeutralizedAlert = false;
    private SectorStatus sectorStatus = new();
    private double warpTimeRemaining = 0;
    private string targetSectorName = "";
    private double carrierHp = 25;
    private double carrierMaxHp = 25;
    private string currentPhase = "Naval";
    private int radarEnemiesCount = 0;
    private int activeThreatCount = 0;
    private bool isWarping = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JSRuntime.InvokeVoidAsync("CarrierCommand.init", "renderCanvas");
            
            var carrier = await JSRuntime.InvokeAsync<IJSObjectReference>("CarrierCommand.loadModel", "data/carrier.json", new double[] { 0, 0, 0 });
            await JSRuntime.InvokeVoidAsync("CarrierCommand.setCarrierRoot", carrier);

            // 1. Apaches (Aft Deck) - 50% Scale
            var apacheScale = new double[] { 0.5, 0.5, 0.5 };
            var apache1 = await JSRuntime.InvokeAsync<IJSObjectReference>("CarrierCommand.loadModel", "data/apache.json", new double[] { -1.5, 1.05, -5.0 }, new double[] { 0, 0, 0 }, apacheScale);
            await JSRuntime.InvokeVoidAsync("CarrierCommand.registerUnit", "apache1", apache1);
            
            var apache2 = await JSRuntime.InvokeAsync<IJSObjectReference>("CarrierCommand.loadModel", "data/apache.json", new double[] { 1.5, 1.05, -6.5 }, new double[] { 0, 0, 0 }, apacheScale);
            await JSRuntime.InvokeVoidAsync("CarrierCommand.registerUnit", "apache2", apache2);

            // 2. F35s (Forward/Mid Deck)
            var f35_1 = await JSRuntime.InvokeAsync<IJSObjectReference>("CarrierCommand.loadModel", "data/f35.json", new double[] { 0.5, 1.05, 5.0 });
            await JSRuntime.InvokeVoidAsync("CarrierCommand.registerUnit", "f35_1", f35_1);

            var f35_2 = await JSRuntime.InvokeAsync<IJSObjectReference>("CarrierCommand.loadModel", "data/f35.json", new double[] { -2.5, 1.05, 2.0 });
            await JSRuntime.InvokeVoidAsync("CarrierCommand.registerUnit", "f35_2", f35_2);
            
            // 3. Combat Vessels (Water - Port & Starboard)
            var vessel1 = await JSRuntime.InvokeAsync<IJSObjectReference>("CarrierCommand.loadModel", "data/combat_vessel.json", new double[] { 15.0, 0, 5.0 }, new double[] { 0, 0, 0 });
            await JSRuntime.InvokeVoidAsync("CarrierCommand.registerUnit", "vessel1", vessel1);
            
            var vessel2 = await JSRuntime.InvokeAsync<IJSObjectReference>("CarrierCommand.loadModel", "data/combat_vessel.json", new double[] { -15.0, 0, -5.0 }, new double[] { 0, 0, 0 });
            await JSRuntime.InvokeVoidAsync("CarrierCommand.registerUnit", "vessel2", vessel2);

            // 4. Defense Turrets
            var turretPositions = new[] {
                new { id = "turret_bow", pos = new double[] { 0, 1.2, 8.5 }, rot = 0.0 },
                new { id = "turret_starboard", pos = new double[] { -3.2, 1.05, 1.0 }, rot = 0.0 },
                new { id = "turret_port", pos = new double[] { 3.2, 1.05, -1.0 }, rot = 180.0 },
                new { id = "turret_aft", pos = new double[] { 0, 0.7, -9.2 }, rot = 180.0 }
            };

            foreach (var t in turretPositions)
            {
                var turret = await JSRuntime.InvokeAsync<IJSObjectReference>("CarrierCommand.loadModel", "data/turret.json", t.pos, new double[] { 0, t.rot, 0 });
                await JSRuntime.InvokeVoidAsync("CarrierCommand.registerTurret", turret);
                await JSRuntime.InvokeVoidAsync("CarrierCommand.setParent", turret, carrier);
            }

            await JSRuntime.InvokeVoidAsync("CarrierCommand.initRadar", "radarUI");

            _ = RadarLoop();
        }
    }

    private async Task ToggleGuns()
    {
        isGunsEngaged = !isGunsEngaged;
        await JSRuntime.InvokeVoidAsync("CarrierCommand.setGunsEngaged", isGunsEngaged);
    }

    private async Task RadarLoop()
    {
        while (true)
        {
            try {
                var data = await JSRuntime.InvokeAsync<RadarData>("CarrierCommand.getRadarData");
                radarSweepAngle = data.SweepAngle;
                carrierHeading = data.Heading;
                radarBlips = data.Enemies;
                unitStates = data.Units;
                isGunsEngaged = data.IsGunsEngaged;
                warpTimeRemaining = data.WarpTimeRemaining;
                targetSectorName = data.TargetSectorName;
                carrierHp = data.CarrierHp;
                carrierMaxHp = data.CarrierMaxHp;
                currentPhase = data.CurrentPhase ?? "Naval";
                radarEnemiesCount = data.Enemies?.Count ?? 0;
                activeThreatCount = data.ActiveThreatCount;
                isWarping = data.IsWarping;

                if (data.IsSectorNeutralized) {
                    showNeutralizedAlert = true;
                }

                StateHasChanged();
            } catch { }
            await Task.Delay(30);
        }
    }

    private async Task ToggleSectorMap()
    {
        showSectorMap = !showSectorMap;
        if (showSectorMap)
        {
            sectorStatus = await JSRuntime.InvokeAsync<SectorStatus>("CarrierCommand.getSectorData");
        }
    }

    private async Task HandleWarp(string sectorId)
    {
        showSectorMap = false;
        await JSRuntime.InvokeVoidAsync("CarrierCommand.jumpToSector", sectorId);
    }

    private async Task AssaultBase()
    {
        await JSRuntime.InvokeVoidAsync("CarrierCommand.assaultBase");
    }

    private async Task LaunchMissile()
    {
        await JSRuntime.InvokeVoidAsync("CarrierCommand.launchCruiseMissile");
    }

    private async Task SetCleared()
    {
        await JSRuntime.InvokeVoidAsync("CarrierCommand.setCleared");
    }
}

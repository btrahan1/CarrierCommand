@page "/"
@inject IJSRuntime JSRuntime

<PageTitle>Carrier Command</PageTitle>

<div class="game-container">
    <canvas id="renderCanvas"></canvas>
    
    <div class="ui-overlay">
        <div class="header-section">
            <h1 class="game-title">Carrier Command</h1>
            <p class="game-subtitle">Captain on the Bridge</p>
        </div>
        
        <div class="tactical-controls">
            <LaunchMenu UnitStates="unitStates" />
            
            <div class="defense-controls">
                <button class="btn-engage @(isGunsEngaged ? "engaged" : "")" @onclick="ToggleGuns">
                    @(isGunsEngaged ? "Guns Engaged" : "Engage Guns")
                </button>
            </div>
        </div>

        <RadarDisplay 
            RadarSweepAngle="radarSweepAngle" 
            CarrierHeading="carrierHeading" 
            RadarBlips="radarBlips" />
    </div>
</div>

<style>
    .game-container {
        position: fixed;
        top: 0;
        left: 0;
        width: 100vw;
        height: 100vh;
        overflow: hidden;
        background: #000;
    }

    #renderCanvas {
        width: 100%;
        height: 100%;
        outline: none;
    }

    .ui-overlay {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        padding: 40px;
        color: white;
        text-shadow: 2px 2px 8px rgba(0,0,0,0.8);
        pointer-events: none;
        box-sizing: border-box;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
    }

    .header-section {
        margin-bottom: 20px;
    }

    .game-title {
        font-size: 4rem;
        margin: 0;
        font-weight: 800;
        letter-spacing: -2px;
        text-transform: uppercase;
        background: linear-gradient(180deg, #fff 0%, #aaa 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }

    .game-subtitle {
        font-size: 1.2rem;
        margin: 0;
        opacity: 0.8;
        font-style: italic;
    }

    .tactical-controls {
        display: flex;
        flex-direction: column;
        gap: 20px;
        width: fit-content;
    }

    .defense-controls {
        pointer-events: auto;
    }

    .btn-engage {
        background: rgba(255, 50, 50, 0.2);
        border: 2px solid #ff4444;
        color: #ff4444;
        padding: 15px 30px;
        font-size: 1.2rem;
        font-weight: bold;
        text-transform: uppercase;
        cursor: pointer;
        transition: all 0.3s;
        border-radius: 4px;
        width: 100%;
        backdrop-filter: blur(5px);
    }

    .btn-engage:hover {
        background: rgba(255, 50, 50, 0.4);
        box-shadow: 0 0 15px rgba(255, 68, 68, 0.5);
    }

    .btn-engage.engaged {
        background: #ff4444;
        color: white;
        animation: pulse-red 1.5s infinite;
    }

    @@keyframes pulse-red {
        0% { box-shadow: 0 0 0 0 rgba(255, 68, 68, 0.7); }
        70% { box-shadow: 0 0 0 15px rgba(255, 68, 68, 0); }
        100% { box-shadow: 0 0 0 0 rgba(255, 68, 68, 0); }
    }
</style>

@code {
    private double radarSweepAngle = 0;
    private double carrierHeading = 0;
    private List<RadarBlip> radarBlips = new();
    private List<UnitStatus> unitStates = new();
    private bool isGunsEngaged = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JSRuntime.InvokeVoidAsync("CarrierCommand.init", "renderCanvas");
            
            var carrier = await JSRuntime.InvokeAsync<IJSObjectReference>("CarrierCommand.loadModel", "data/carrier.json", new double[] { 0, 0, 0 });
            await JSRuntime.InvokeVoidAsync("CarrierCommand.setCarrierRoot", carrier);

            // 1. Apaches (Aft Deck) - 50% Scale
            var apacheScale = new double[] { 0.5, 0.5, 0.5 };
            var apache1 = await JSRuntime.InvokeAsync<IJSObjectReference>("CarrierCommand.loadModel", "data/apache.json", new double[] { -1.5, 1.05, -5.0 }, new double[] { 0, 0, 0 }, apacheScale);
            await JSRuntime.InvokeVoidAsync("CarrierCommand.registerUnit", "apache1", apache1);
            
            var apache2 = await JSRuntime.InvokeAsync<IJSObjectReference>("CarrierCommand.loadModel", "data/apache.json", new double[] { 1.5, 1.05, -6.5 }, new double[] { 0, 0, 0 }, apacheScale);
            await JSRuntime.InvokeVoidAsync("CarrierCommand.registerUnit", "apache2", apache2);

            // 2. F35s (Forward/Mid Deck)
            var f35_1 = await JSRuntime.InvokeAsync<IJSObjectReference>("CarrierCommand.loadModel", "data/f35.json", new double[] { 0.5, 1.05, 5.0 });
            await JSRuntime.InvokeVoidAsync("CarrierCommand.registerUnit", "f35_1", f35_1);

            var f35_2 = await JSRuntime.InvokeAsync<IJSObjectReference>("CarrierCommand.loadModel", "data/f35.json", new double[] { -2.5, 1.05, 2.0 });
            await JSRuntime.InvokeVoidAsync("CarrierCommand.registerUnit", "f35_2", f35_2);
            
            // 3. Combat Vessels (Water - Port & Starboard)
            var vessel1 = await JSRuntime.InvokeAsync<IJSObjectReference>("CarrierCommand.loadModel", "data/combat_vessel.json", new double[] { 15.0, 0, 5.0 }, new double[] { 0, 0, 0 });
            await JSRuntime.InvokeVoidAsync("CarrierCommand.registerUnit", "vessel1", vessel1);
            
            var vessel2 = await JSRuntime.InvokeAsync<IJSObjectReference>("CarrierCommand.loadModel", "data/combat_vessel.json", new double[] { -15.0, 0, -5.0 }, new double[] { 0, 0, 0 });
            await JSRuntime.InvokeVoidAsync("CarrierCommand.registerUnit", "vessel2", vessel2);

            // 4. Defense Turrets
            var turretPositions = new[] {
                new { id = "turret_bow", pos = new double[] { 0, 1.2, 8.5 }, rot = 0.0 },
                new { id = "turret_starboard", pos = new double[] { -3.2, 1.05, 1.0 }, rot = 0.0 },
                new { id = "turret_port", pos = new double[] { 3.2, 1.05, -1.0 }, rot = 180.0 },
                new { id = "turret_aft", pos = new double[] { 0, 0.7, -9.2 }, rot = 180.0 }
            };

            foreach (var t in turretPositions)
            {
                var turret = await JSRuntime.InvokeAsync<IJSObjectReference>("CarrierCommand.loadModel", "data/turret.json", t.pos, new double[] { 0, t.rot, 0 });
                await JSRuntime.InvokeVoidAsync("CarrierCommand.registerTurret", turret);
                await JSRuntime.InvokeVoidAsync("CarrierCommand.setParent", turret, carrier);
            }

            await JSRuntime.InvokeVoidAsync("CarrierCommand.initRadar", "radarUI");

            _ = RadarLoop();
        }
    }

    private async Task ToggleGuns()
    {
        isGunsEngaged = !isGunsEngaged;
        await JSRuntime.InvokeVoidAsync("CarrierCommand.setGunsEngaged", isGunsEngaged);
    }

    private async Task RadarLoop()
    {
        while (true)
        {
            try {
                var data = await JSRuntime.InvokeAsync<RadarData>("CarrierCommand.getRadarData");
                radarSweepAngle = data.SweepAngle;
                carrierHeading = data.Heading;
                radarBlips = data.Enemies;
                unitStates = data.Units;
                isGunsEngaged = data.IsGunsEngaged;
                StateHasChanged();
            } catch { }
            await Task.Delay(30);
        }
    }
}

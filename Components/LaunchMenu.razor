
@using CarrierCommand.Models
@inject IJSRuntime JSRuntime

<div class="launch-menu">
    <h3>Tactical Launch</h3>
    <div class="launch-buttons">
        @foreach (var unit in UnitStates)
        {
            var isDamaged = unit.State == "OnDeck" && unit.Hp < unit.MaxHp;
            <div class="unit-control">
                <button class="btn-launch @(IsUnitFlying(unit.Id) ? "flying" : "")" 
                        @onclick="() => ToggleUnit(unit.Id)"
                        disabled="@isDamaged">
                    @(GetButtonText(unit))
                </button>
                <div class="hp-gauge">
                    <div class="hp-fill @(unit.Hp < 10 ? "critical" : "")" 
                         style="width: @( (unit.Hp / unit.MaxHp) * 100 )%"></div>
                </div>
                @if (isDamaged)
                {
                    <span class="repair-tag">REPAIRING...</span>
                }
            </div>
        }
    </div>
</div>

<style>
    .launch-menu {
        pointer-events: auto;
        background: rgba(0, 20, 40, 0.6);
        padding: 20px;
        border-radius: 8px;
        border-left: 4px solid #00aaff;
        width: fit-content;
        backdrop-filter: blur(5px);
    }

    .launch-menu h3 {
        font-size: 0.9rem;
        text-transform: uppercase;
        margin-bottom: 15px;
        color: #00aaff;
        letter-spacing: 1px;
    }

    .launch-buttons {
        display: flex;
        flex-direction: column;
        gap: 10px;
    }

    .btn-launch {
        background: rgba(255, 255, 255, 0.1);
        border: 1px solid rgba(255, 255, 255, 0.2);
        color: white;
        padding: 10px 20px;
        font-size: 1rem;
        cursor: pointer;
        transition: all 0.2s;
        text-align: left;
        border-radius: 4px;
    }

    .btn-launch:hover {
        background: #00aaff;
        border-color: #00aaff;
        transform: translateX(5px);
    }

    .btn-launch.flying {
        border-color: #ff9900;
        color: #ff9900;
    }
    .btn-launch.flying:hover {
        background: #ff9900;
        color: white;
    }

    .btn-launch:disabled {
        opacity: 0.5;
        cursor: not-allowed;
        background: rgba(255, 0, 0, 0.1);
    }

    .unit-control {
        display: flex;
        flex-direction: column;
        gap: 5px;
        margin-bottom: 15px;
    }

    .hp-gauge {
        height: 3px;
        background: rgba(255,255,255,0.1);
        width: 100%;
        border-radius: 2px;
        overflow: hidden;
    }

    .hp-fill {
        height: 100%;
        background: #00ff88;
        box-shadow: 0 0 5px #00ff88;
        transition: width 0.3s ease;
    }

    .hp-fill.critical {
        background: #ff4400;
        box-shadow: 0 0 5px #ff4400;
    }

    .repair-tag {
        font-size: 0.6rem;
        color: #ffcc00;
        letter-spacing: 2px;
        font-weight: bold;
        animation: blink 1s infinite;
    }
</style>

@code {
    [Parameter] public List<UnitStatus> UnitStates { get; set; } = new();

    private bool IsUnitFlying(string id)
    {
        var unit = UnitStates.FirstOrDefault(u => u.Id == id);
        return unit != null && unit.State != "OnDeck";
    }

    private string GetButtonText(UnitStatus unit)
    {
        string name = unit.Id.ToUpper();
        if (unit.State == "OnDeck") {
            if (unit.Hp < unit.MaxHp) return $"REPAIRING {name}";
            return $"Launch {name}";
        }
        if (unit.State == "Returning") return $"Recovering {name}...";
        return $"Return {name}";
    }

    private async Task ToggleUnit(string id)
    {
        if (IsUnitFlying(id))
        {
            await JSRuntime.InvokeVoidAsync("CarrierCommand.returnUnitToBase", id);
        }
        else
        {
            await JSRuntime.InvokeVoidAsync("CarrierCommand.launchUnit", id);
        }
    }
}
